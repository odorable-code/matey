    <update id="updateUser">
        UPDATE users
        <set>
            <if test="user.userPw != null">user_pw = #{user.userPw},</if>
            <if test="user.userName != null">user_name = #{user.userName},</if>
            <if test="user.userEmail != null">user_email = #{user.userEmail},</if>
            <if test="user.userAddr != null">user_addr = #{user.userAddr},</if>
            <if test="user.userPhone != null">user_phone = #{user.userPhone},</if>
            <if test="user.userBirth != null">user_birth = #{user.userBirth},</if>
            <if test="user.userGender != null">user_gender = #{user.userGender},</if>
            <if test="user.userAlert != false">user_alert = #{user.userAlert},</if>
            <if test="user.termsAgreed != false">terms_agreed = #{user.termsAgreed},</if>
            <if test="user.locationAgreed != false">location_agreed = #{user.locationAgreed},</if>
            <if test="user.role != null">role = #{user.role},</if>
        </set>
        WHERE user_num = #{userNum}
    </update>
    <delete id="deleteUser">
        DELETE FROM users
        WHERE user_num = #{userNum}
    </delete>
    <select id="selectUser" resultType="kr.hi.matey.vo.UserVO">
        SELECT * FROM users WHERE user_id = #{userId}
    </select>
    <select id="selectUsers" resultType="kr.hi.matey.vo.UserVO">
        SELECT * FROM users LIMIT 1000
    </select>

    <select id="findByUserId">
        SELECT
        admin_id
        admin_pw,
        admin_name,
        role
        FROM hospital_admins
        WHERE admin_phone = #{adminPhone} AND admin_email = #{adminEmail}

        UNION

        SELECT
        user_id
        user_pw,
        user_name,
        role
        FROM users
        WHERE user_phone = #{userPhone} AND user_email = #{userEmail}
    </select>

    <select id="existsByUserId" parameterType="string" resultType="int">
        select count(*) from
        (SELECT admin_id as id FROM hospital_admins
        UNION
        SELECT user_id as id FROM users) as total_users
        where id = #{userId}
    </select>

