    <select id="findUserId" resultType="String">
        SELECT user_id FROM users
        WHERE user_phone = #{phone} AND user_email = #{email}

        UNION

        SELECT admin_id FROM hospital_admins
        WHERE admin_phone = #{phone} AND admin_email = #{email};
    </select>
    <select id="selectUserByUserNum" resultType="kr.hi.matey.vo.UserVO">
        select * from users where user_num = #{userNum}
    </select>

    <select id="existsByAdminEmail" resultType="boolean">
